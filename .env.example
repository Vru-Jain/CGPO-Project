# ──────────────────────────────────────────────────────────────────────────────
# CGPO environment variables — TEMPLATE. Copy real values into the right place;
# never commit real keys. (frontend/.env.local and .env are gitignored.)
# ──────────────────────────────────────────────────────────────────────────────

# ── FRONTEND ──────────────────────────────────────────────────────────────────
# Local dev: put these in frontend/.env.local
# Production: set them in Vercel → Settings → Environment Variables (All Environments)

# Modal backend URL the frontend calls.
NEXT_PUBLIC_BACKEND_URL=https://vrushabhjain2016--cgpo-backend-serve.modal.run

# Optional API key sent as X-API-Key. Must match the backend CGPO_API_KEY below.
# NOTE: NEXT_PUBLIC_* is embedded in the browser bundle, so this is NOT a real
# secret — it only deters casual hits. Leave blank to disable.
NEXT_PUBLIC_API_KEY=

# Clerk authentication (gates /dashboard). Get both from dashboard.clerk.com.
# The publishable key is public by design; the secret key must NOT have the
# NEXT_PUBLIC_ prefix and must never reach the browser or git.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── BACKEND (Modal) ───────────────────────────────────────────────────────────
# These are set as a Modal secret, NOT in a local .env, e.g.:
#   modal secret create cgpo-secrets CGPO_API_KEY=your-key ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional API key; if unset, the backend skips X-API-Key auth.
CGPO_API_KEY=

# Comma-separated CORS origins (optional; defaults to * if unset).
ALLOWED_ORIGINS=

# NOTE: CGPO_MODEL_DIR (/models) and CGPO_MODEL_VOLUME (cgpo-models) are set in
# backend/modal_app.py (env=...) and back the Modal Volume that persists the
# trained model across cold starts — you don't set these by hand.
